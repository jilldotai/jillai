# Jill.ai local configuration template
# Copy to .env.local and adjust values for your environment.

# Public site URL used for absolute links/callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flag for smooth scroll provider when Lenis is added.
NEXT_PUBLIC_ENABLE_LENIS=false

# Contact form anti-abuse defaults for upcoming API route.
# Max requests per IP inside the configured window.
CONTACT_RATE_LIMIT_MAX=8
# Window size in milliseconds (example: 10 minutes).
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Optional destination address for contact form notifications.
CONTACT_NOTIFICATION_TO=hello@jilldotai.co.za
